# ─ Supabase ─────────────────────────────────────────────────────────────
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ─ Site URL ─────────────────────────────────────────────────────────────
# Used for Open Graph and canonical URLs. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=https://amirhussen.com

# ─ Analytics (optional) ──────────────────────────────────────────────────
# If you add Google Analytics, add the measurement ID here
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
